{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ExampleConfig",
  "description": "Example app configuration.",
  "type": "object",
  "properties": {
    "store": {
      "description": "The record store the app writes to.",
      "$ref": "#/$defs/StoreConfig"
    },
    "tables": {
      "description": "Lookup tables loaded at startup.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/TableConfig"
      }
    },
    "outputs": {
      "description": "Outputs, by name.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/OutputConfig"
      }
    }
  },
  "required": [
    "store",
    "tables",
    "outputs"
  ],
  "$defs": {
    "StoreConfig": {
      "description": "How the app reaches its store.",
      "type": "object",
      "properties": {
        "host": {
          "description": "Store host name.",
          "type": "string"
        },
        "protocol": {
          "description": "Wire protocol to the store.",
          "$ref": "#/$defs/Protocol"
        },
        "codec": {
          "description": "Codec for each batch. Unset sends batches uncompressed.",
          "anyOf": [
            {
              "$ref": "#/$defs/Codec"
            },
            {
              "type": "null"
            }
          ]
        },
        "tls": {
          "description": "TLS to the store.",
          "$ref": "#/$defs/TlsConfig"
        }
      },
      "required": [
        "host",
        "protocol",
        "tls"
      ]
    },
    "Protocol": {
      "description": "Wire protocol.",
      "type": "string",
      "enum": [
        "http",
        "native"
      ]
    },
    "Codec": {
      "description": "Batch codec.",
      "type": "string",
      "enum": [
        "gzip",
        "zstd"
      ]
    },
    "TlsConfig": {
      "description": "TLS settings.",
      "type": "object",
      "properties": {
        "mode": {
          "description": "Whether the server certificate is checked.",
          "$ref": "#/$defs/TlsMode"
        }
      },
      "required": [
        "mode"
      ]
    },
    "TlsMode": {
      "description": "TLS mode.",
      "oneOf": [
        {
          "description": "Plain TCP.",
          "type": "string",
          "const": "off"
        },
        {
          "description": "TLS with the server certificate checked.",
          "type": "string",
          "const": "verify"
        }
      ]
    },
    "TableConfig": {
      "description": "One lookup table.",
      "type": "object",
      "properties": {
        "path": {
          "description": "Path of the table file.",
          "type": "string"
        },
        "format": {
          "description": "File format of the table.",
          "$ref": "#/$defs/TableFormat"
        }
      },
      "required": [
        "path",
        "format"
      ]
    },
    "TableFormat": {
      "description": "Table file format.",
      "type": "string",
      "enum": [
        "csv",
        "json"
      ]
    },
    "OutputConfig": {
      "description": "One output.",
      "type": "object",
      "properties": {
        "levels": {
          "description": "Log levels sent to this output.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Level"
          }
        }
      },
      "required": [
        "levels"
      ]
    },
    "Level": {
      "description": "Log level.",
      "type": "string",
      "enum": [
        "debug",
        "info",
        "warn"
      ]
    }
  }
}
